---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Showcase from '../components/Showcase.astro';
import Bento from '../components/Bento.astro';
import Flow from '../components/Flow.astro';
import Details from '../components/Details.astro';
import CTA from '../components/CTA.astro';
import type { Lang } from '../i18n/routes';
import { APP_URL, SITE_NAME } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const meta = {
  es: {
    title: 'Centro Distribución — Inventario y operaciones de depósito',
    description: 'Conectá catálogo, inventario y tareas de depósito en una plataforma para operaciones de abastecimiento y distribución.',
    desc: 'Plataforma modular para inventario, depósitos y operaciones de abastecimiento y distribución.',
  },
  en: {
    title: 'Centro Distribución — Inventory and warehouse operations',
    description: 'Connect catalog, inventory and warehouse tasks in a platform for supply and distribution operations.',
    desc: 'A modular platform for inventory, warehouses, supply and distribution operations.',
  },
}[lang];
const ld = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: SITE_NAME, applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: meta.desc, ...(APP_URL ? { url: APP_URL } : {}) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: new URL(lang === 'es' ? '/' : '/en/', Astro.site).href, inLanguage: lang },
];
---
<Layout title={meta.title} description={meta.description} lang={lang} routeKey="home" jsonLd={ld}>
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <Showcase lang={lang} />
  <Bento lang={lang} />
  <Flow lang={lang} />
  <Details lang={lang} />
  <CTA lang={lang} />
</Layout>

