---
import Icon from './Icon.astro';
import { url, type Lang } from '../i18n/routes';
import { home } from '../i18n/home';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const c = home[lang].cta;
---
<section id="empezar" class="section pb-28">
  <div class="wrap-wide">
    <div class="cta-panel" data-reveal>
      <div><p class="eyebrow">{lang === 'es' ? 'Hablemos de tu operación' : 'Let’s talk about your operation'}</p><h2 class="h-section">{c.h2}</h2></div>
      <div class="cta-copy"><p class="lead">{c.lead}</p><div class="mt-7 flex flex-wrap gap-3"><a href={url('contact', lang)} class="btn btn-primary btn-lg">{c.primary}<Icon name="arrow-right" size={17} /></a><a href="#funciones" class="btn btn-ghost btn-lg">{c.secondary}</a></div></div>
    </div>
  </div>
</section>
<style>
  .cta-panel { display:grid; grid-template-columns:1fr .8fr; gap:clamp(2rem,7vw,7rem); align-items:end; padding:clamp(2rem,6vw,5.5rem); background:#18342c; color:#fff; }
  .cta-panel .eyebrow { color:#a5d5c2; }.cta-panel h2 { max-width:12ch; color:#fff; background:none; -webkit-text-fill-color:#fff; }
  .cta-copy .lead { color:rgba(255,255,255,.76); }.cta-copy :global(.btn-ghost) { color:#fff; border-color:rgba(255,255,255,.34); }
  @media(max-width:760px) { .cta-panel { grid-template-columns:1fr; align-items:start; } }
</style>
