---
import Layout from '../layouts/Layout.astro';
import InnerHero from '../components/InnerHero.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../i18n/pages';
import { ui } from '../i18n/ui';
import { url, type Lang } from '../i18n/routes';
import { CONTACT_EMAIL } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = contact[lang];
const t = ui[lang].common;
const crumbs = [{ name: t.breadcrumbHome, href: url('home', lang) }, { name: c.metaTitle, href: url('contact', lang) }];
---
<Layout title={c.metaTitle} description={c.metaDesc} lang={lang} routeKey="contact" breadcrumbs={crumbs}>
  <InnerHero eyebrow={c.metaTitle} title={c.h1} lead={c.lead} />
  <section class="section !pt-4 pb-28">
    <div class="wrap max-w-[960px]">
      <ul class="grid gap-4 md:grid-cols-3">
        {c.topics.map(([ic, title, text]) => (
          <li class="fcap spot" data-reveal><span class="fcap-ic"><Icon name={ic} size={20} /></span><h2>{title}</h2><p>{text}</p></li>
        ))}
      </ul>
      <div class="cta noise relative mt-6 overflow-hidden rounded-[2rem] px-6 py-14 text-center" data-reveal>
        <p class="text-fg-2">{c.email}</p>
        <a href={`mailto:${CONTACT_EMAIL}`} class="mt-2 -mb-1 inline-block py-1 text-[clamp(1.5rem,4vw,2.6rem)] font-semibold tracking-tight text-white underline decoration-accent-2/50 underline-offset-8 transition-colors hover:decoration-accent-2">{CONTACT_EMAIL}</a>
        <p class="mt-5 text-[.85rem] text-fg-3">{c.hint}</p>
      </div>
    </div>
  </section>
</Layout>
