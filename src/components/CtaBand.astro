---
import Icon from './Icon.astro';
import { url, type Lang } from '../i18n/routes';
interface Props { title: string; text?: string; primary: string; secondaryHref?: string; secondary?: string; lang?: Lang }
const { title, text, primary, secondaryHref, secondary, lang = 'es' } = Astro.props;
---
<section class="section !pt-8 pb-28">
  <div class="wrap-wide">
    <div class="cta noise relative overflow-hidden rounded-[2rem] px-6 py-16 text-center sm:px-12 md:py-24">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute left-1/2 top-[70%] h-[80%] w-[70%] -translate-x-1/2 rounded-full bg-accent/45 blur-[100px]"></div>
      </div>
      <h2 class="h-section relative mx-auto max-w-[20ch] grad-text" data-reveal>{title}</h2>
      {text && <p class="lead relative mx-auto mt-5 max-w-[32rem]" data-reveal>{text}</p>}
      <div class="relative mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" data-reveal>
        <a href={url('contact', lang)} data-magnetic class="btn btn-primary btn-lg">{primary} <Icon name="arrow-right" class="arrow" /></a>
        {secondaryHref && secondary && <a href={secondaryHref} data-magnetic class="btn btn-ghost btn-lg">{secondary}</a>}
      </div>
    </div>
  </div>
</section>

