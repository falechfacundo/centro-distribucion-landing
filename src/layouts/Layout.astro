---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { routes, url, ogLocale, otherLang, type Lang, type RouteKey } from '../i18n/routes';
import { SITE_NAME, APP_URL } from '../config';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  routeKey?: RouteKey;
  /** Rutas equivalentes por idioma (para posts de blog u otras rutas dinámicas). */
  alternates?: Partial<Record<Lang, string>>;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; href: string }[];
  publishedTime?: string;
}
const { title, description, lang = 'es', routeKey, alternates, ogType = 'website', ogImage = '/og.png', noindex = false, jsonLd = [], breadcrumbs, publishedTime } = Astro.props;

const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const alts: Partial<Record<Lang, string>> = alternates ?? (routeKey ? { es: url(routeKey, 'es'), en: url(routeKey, 'en') } : {});
const self = alts[lang] ?? Astro.url.pathname;
const other = otherLang(lang);
const switchHref = alts[other] ?? url('home', other);
const canonical = abs(self);
const fullTitle = title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;

const org = { '@context': 'https://schema.org', '@type': 'Organization', name: SITE_NAME, url: abs('/'), logo: abs('/favicon.svg') };
const crumbs = breadcrumbs && breadcrumbs.length
  ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: abs(b.href) })) }
  : null;
const ld = [org, ...(crumbs ? [crumbs] : []), ...jsonLd];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0e" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {alts.es && <link rel="alternate" hreflang="es" href={abs(alts.es)} />}
    {alts.en && <link rel="alternate" hreflang="en" href={abs(alts.en)} />}
    {alts.es && <link rel="alternate" hreflang="x-default" href={abs(alts.es)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage)} />
    <JsonLd data={ld} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const d = document.documentElement;
        d.classList.add('js-motion');
        // si motion.ts no corre (falla de red/JS), mostrar el contenido en vez de dejarlo oculto
        setTimeout(() => { if (!d.dataset.motion) d.classList.remove('js-motion'); }, 4000);
      }
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-white">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Nav lang={lang} switchHref={switchHref} />
    <main id="main"><slot /></main>
    <Footer lang={lang} switchHref={switchHref} />
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
