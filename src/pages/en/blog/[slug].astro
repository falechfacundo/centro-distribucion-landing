---
import BlogPost from '../../../views/BlogPost.astro';
import { getPosts, slugOf } from '../../../i18n/blog';
export async function getStaticPaths() {
  const posts = await getPosts('en');
  return posts.map((post) => ({ params: { slug: slugOf(post) }, props: { post, slug: slugOf(post) } }));
}
const { post, slug } = Astro.props;
---
<BlogPost lang="en" post={post} slug={slug} />
