---
import Icon from './Icon.astro';
import { home } from '../i18n/home';
import type { Lang } from '../i18n/routes';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const c = home[lang].showcase;
const rows = c.rows.slice(0, 5);
---
<section id="producto" class="section" aria-labelledby="showcase-title">
  <div class="wrap-wide grid items-center gap-12 lg:grid-cols-[.85fr_1.15fr] lg:gap-20">
    <div>
      <p class="eyebrow mb-5" data-reveal>{c.eyebrow}</p>
      <h2 id="showcase-title" class="h-section" data-reveal>{c.h2a} <span class="grad-text">{c.h2b}</span></h2>
      <p class="lead mt-6" data-reveal>{home[lang].bento.lead}</p>
      <div class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
        {c.steps.map((s) => <article class="sc-step" data-reveal><span class="sc-ic"><Icon name={s.icon} size={18} /></span><div><h3>{s.title}</h3><p>{s.text}</p></div></article>)}
      </div>
    </div>
    <div class="sc-panel" data-reveal>
      <div class="sc-panel-head"><div><span>{c.label}</span><h3>{c.listHead}</h3></div><span class="sc-count">{c.listCount}</span></div>
      <div class="sc-table-wrap"><table><thead><tr><th>{lang === 'es' ? 'Producto' : 'Product'}</th><th>SKU</th><th>{lang === 'es' ? 'Ubicación' : 'Location'}</th><th>{lang === 'es' ? 'Estado' : 'Status'}</th></tr></thead><tbody>
        {rows.map(([name, tag, sku, status, location]) => <tr><td>{name}</td><td class="sc-mono">{sku}</td><td>{location}</td><td><span class={`sc-status ${status}`}>{c.status[status]}</span></td></tr>)}
      </tbody></table></div>
      <p class="sc-foot"><Icon name="info" size={15} />{home[lang].board.preview}</p>
    </div>
  </div>
</section>
<style>
  .sc-step { display:flex; gap:14px; align-items:flex-start; padding:0; border:0; background:transparent; text-align:left; }
  .sc-ic { flex:none; display:grid; place-items:center; width:38px; height:38px; border:1px solid var(--color-line-strong); border-radius:11px; color:var(--color-accent-2); background:var(--color-surface); }
  .sc-step h3 { margin:2px 0 4px; color:var(--color-fg); font-size:1rem; font-weight:650; }
  .sc-step p { margin:0; color:var(--color-fg-2); font-size:.9rem; line-height:1.6; }
  .sc-panel { min-width:0; padding:clamp(1.1rem,3vw,2rem); border:1px solid var(--color-line-strong); background:var(--color-card); box-shadow:0 24px 70px -50px rgba(20,54,43,.42); }
  .sc-panel-head { display:flex; justify-content:space-between; align-items:end; gap:1rem; padding-bottom:1.4rem; border-bottom:1px solid var(--color-line); }
  .sc-panel-head span { color:var(--color-fg-3); font: .68rem var(--font-mono); letter-spacing:.07em; text-transform:uppercase; }
  .sc-panel-head h3 { margin:.4rem 0 0; font-size:1.12rem; color:var(--color-fg); }
  .sc-count { max-width:11rem; text-align:right; }
  .sc-table-wrap { overflow-x:auto; }
  table { width:100%; min-width:520px; border-collapse:collapse; text-align:left; }
  th { padding:1rem .65rem .75rem; color:var(--color-fg-3); font: .65rem var(--font-mono); text-transform:uppercase; letter-spacing:.08em; }
  td { padding:.9rem .65rem; border-top:1px solid var(--color-line); color:var(--color-fg-2); font-size:.83rem; }
  td:first-child { color:var(--color-fg); font-weight:550; }
  .sc-mono { font: .73rem var(--font-mono); }
  .sc-status { display:inline-block; padding:.28rem .48rem; border-radius:4px; background:var(--color-surface); color:var(--color-fg-2); font-size:.7rem; white-space:nowrap; }
  .sc-status.done { color:#17664d; background:#e4f3e9; }.sc-status.prog { color:#16617c; background:#e2f1f5; }.sc-status.rev { color:#825511; background:#f7efdc; }
  .sc-foot { display:flex; align-items:center; gap:.5rem; margin:1rem 0 0; color:var(--color-fg-3); font-size:.72rem; }
</style>
