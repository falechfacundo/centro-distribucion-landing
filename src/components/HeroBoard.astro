---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { home, tagColor } from '../i18n/home';
import type { Lang } from '../i18n/routes';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const c = home[lang].board;
const people: Record<string, string> = { SM: '#0f9f8e', MR: '#0ea5e9', LV: '#ec4899', DP: '#f59e0b' };
// texto de cada avatar: blanco solo donde llega a 4.5:1 (violeta); oscuro sobre celeste, rosa y ámbar
const peopleText: Record<string, string> = { SM: '#fff', MR: '#08080a', LV: '#08080a', DP: '#08080a' };
const colColors = ['#6b6a7d', '#38bdf8', '#fbbf24', '#34d399'];
const columns = c.cols.map((name, ci) => ({
  name, color: colColors[ci],
  cards: Object.entries(c.cards).filter(([, k]) => k.col === ci).map(([id, k]) => ({ id, ...k, tagName: c.tags[k.tag], tagC: tagColor(k.tag) })),
}));
const nav = ['layout-dashboard', 'folder', 'layers', 'arrow-right', 'users', 'flag'];
---
<p class="mb-3 text-center font-mono text-[.68rem] uppercase tracking-[.12em] text-fg-3">{c.preview}</p>
<div class="hero-stage" data-hero-stage>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-tilt" data-hero-tilt>
    <div class="hero-fit" data-hero-fit>
      <div class="app" data-app aria-label={c.preview} role="img">
        <div class="chrome">
          <div class="dots"><i></i><i></i><i></i></div>
          <div class="url"><Icon name="shield-check" size={12} /> {c.url}</div>
          <div class="chrome-r"></div>
        </div>
        <div class="body">
          <aside class="side">
            <div class="side-logo"><Logo size={17} /></div>
            <ul>
              {nav.map((ic, i) => (
                <li class={i === 2 ? 'on' : ''}><Icon name={ic} size={15} /> {c.nav[i]}</li>
              ))}
            </ul>
            <div class="side-foot">
              <span class="pill-dot"></span> {c.ws}
            </div>
          </aside>
          <main class="main">
            <div class="head">
              <div class="proj">
                <span class="proj-ic"><Icon name="rocket" size={15} /></span>
                <div>
                  <div class="proj-name">{c.project}</div>
                  <div class="proj-sub">{c.sprintSub}</div>
                </div>
              </div>
              <div class="tabs">
                <span class="on">{c.tabs[0]}</span><span>{c.tabs[1]}</span><span>{c.tabs[2]}</span><span>{c.tabs[3]}</span>
              </div>
              <div class="prog">
                <div class="prog-top"><span>{c.progress}</span><b data-pct>25%</b></div>
                <div class="prog-bar"><i data-bar></i></div>
              </div>
            </div>
            <div class="board" data-board>
              {columns.map((c, ci) => (
                <section class="col">
                  <header>
                    <span class="col-dot" style={`background:${c.color};box-shadow:0 0 12px ${c.color}88`}></span>
                    <span class="col-name">{c.name}</span>
                    <span class="col-count" data-count>{c.cards.length}</span>
                  </header>
                  <div class="col-cards" data-col={ci}>
                    {c.cards.map((k) => (
                      <article class="card" data-card={k.id}>
                        <div class="tag" style={`--c:${k.tagC}`}><i></i>{k.tagName}</div>
                        <p class="ttl">{k.title}</p>
                        <footer>
                          <span class="key">{k.key}</span>
                          <span class="prio" data-p={k.p}><i></i><i></i><i></i></span>
                          <span class="av" style={`background:${people[k.who]};color:${peopleText[k.who]}`}>{k.who}</span>
                        </footer>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
              <div class="cursor" data-cursor style="--cc:#0f9f8e" aria-hidden="true">
                <svg width="18" height="20" viewBox="0 0 18 20" fill="none"><path d="M1.2 1.2 16 8.6l-6.2 1.9L7.4 17 1.2 1.2Z" fill="var(--cc)" stroke="#fff" stroke-width="1.3" stroke-linejoin="round"/></svg>
                <span>{c.cursor1}</span>
              </div>
              <div class="cursor cursor-2" data-cursor2 style="--cc:#db2777" aria-hidden="true">
                <svg width="18" height="20" viewBox="0 0 18 20" fill="none"><path d="M1.2 1.2 16 8.6l-6.2 1.9L7.4 17 1.2 1.2Z" fill="var(--cc)" stroke="#fff" stroke-width="1.3" stroke-linejoin="round"/></svg>
                <span>{c.cursor2}</span>
              </div>
            </div>
          </main>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .hero-stage { position: relative; perspective: 1800px; perspective-origin: 50% 0%; }
  .hero-glow {
    position: absolute; left: 50%; top: 8%; width: 86%; height: 70%; transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(15, 159, 142, 0.5), rgba(15, 159, 142, 0.12) 60%, transparent);
    filter: blur(70px); pointer-events: none; z-index: 0;
  }
  .hero-tilt { position: relative; z-index: 1; transform-style: preserve-3d; transform-origin: 50% 0%; will-change: transform; }
  .hero-fit { position: relative; width: 100%; height: 620px; }

  .app {
    --w: 1040px;
    position: absolute; left: 0; top: 0; width: var(--w); transform-origin: 0 0;
    border-radius: 18px; overflow: hidden; background: #0e0e12; color: #f4f3f8;
    font-size: 12.5px; line-height: 1.35; user-select: none;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.09),
      0 1px 0 rgba(255, 255, 255, 0.12) inset,
      0 60px 120px -30px rgba(0, 0, 0, 0.9),
      0 30px 80px -20px rgba(15, 159, 142, 0.35);
  }
  .app .chrome { display: flex; align-items: center; gap: 12px; padding: 11px 14px; background: #0a0a0d; border-bottom: 1px solid rgba(255,255,255,.06); }
  .app .dots { display: flex; gap: 6px; } .app .dots i { width: 10px; height: 10px; border-radius: 99px; background: #26262e; }
  .app .url { margin: 0 auto; display: flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 8px; background: #16161b; color: #8b8a9b; font-family: var(--font-mono); font-size: 11px; }
  .app .url svg { color: #34d399; } .app .chrome-r { width: 46px; }
  .app .body { display: flex; min-height: 560px; }

  .app .side { width: 188px; flex: none; padding: 16px 12px; border-right: 1px solid rgba(255,255,255,.06); background: #0c0c10; display: flex; flex-direction: column; gap: 18px; }
  .app .side-logo { padding: 2px 8px 6px; color: #fff; }
  .app .side ul { display: grid; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .app .side li { display: flex; align-items: center; gap: 9px; padding: 8px 10px; border-radius: 8px; color: #8b8a9b; }
  .app .side li.on { background: rgba(15,159,142,.16); color: #fff; box-shadow: inset 0 0 0 1px rgba(15,159,142,.35); }
  .app .side li.on svg { color: #54d6b7; }
  .app .side-foot { margin-top: auto; display: flex; align-items: center; gap: 8px; padding: 10px; border-radius: 10px; background: #14141a; color: #8b8a9b; font-size: 11px; }
  .app .pill-dot { width: 7px; height: 7px; border-radius: 9px; background: #34d399; box-shadow: 0 0 10px #34d399; }

  .app .main { flex: 1; min-width: 0; padding: 18px 20px 20px; background: radial-gradient(90% 50% at 50% 0%, rgba(15,159,142,.07), transparent 70%), #0e0e12; }
  .app .head { display: flex; align-items: center; gap: 18px; margin-bottom: 18px; }
  .app .proj { display: flex; align-items: center; gap: 10px; }
  .app .proj-ic { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: linear-gradient(135deg, #35bba4, #087666); color: #fff; box-shadow: 0 6px 16px -4px rgba(15,159,142,.7); }
  .app .proj-name { font-size: 15px; font-weight: 600; letter-spacing: -0.02em; }
  .app .proj-sub { color: var(--color-fg-3); font-size: 11px; }
  .app .tabs { display: flex; gap: 2px; padding: 3px; border-radius: 10px; background: #15151a; margin-left: 6px; }
  .app .tabs span { padding: 5px 11px; border-radius: 7px; color: #8b8a9b; font-size: 12px; }
  .app .tabs .on { background: #23232b; color: #fff; box-shadow: 0 1px 0 rgba(255,255,255,.08) inset; }
  .app .prog { margin-left: auto; width: 170px; }
  .app .prog-top { display: flex; justify-content: space-between; color: #8b8a9b; font-size: 11px; margin-bottom: 6px; } .app .prog-top b { color: #fff; font-weight: 600; font-variant-numeric: tabular-nums; }
  .app .prog-bar { height: 5px; border-radius: 9px; background: #1e1e25; overflow: hidden; }
  .app .prog-bar i { display: block; height: 100%; width: 25%; border-radius: 9px; background: linear-gradient(90deg, #0f9f8e, #54d6b7); box-shadow: 0 0 12px rgba(84,214,183,.8); }

  .app .board { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; align-items: start; }
  .app .col { min-width: 0; padding: 10px; border-radius: 14px; background: rgba(255,255,255,.022); box-shadow: inset 0 0 0 1px rgba(255,255,255,.045); min-height: 400px; }
  .app .col > header { display: flex; align-items: center; gap: 8px; padding: 2px 4px 10px; }
  .app .col-dot { width: 8px; height: 8px; border-radius: 9px; }
  .app .col-name { font-weight: 600; font-size: 12px; }
  .app .col-count { margin-left: auto; min-width: 20px; text-align: center; padding: 1px 6px; border-radius: 99px; background: #1b1b22; color: #8b8a9b; font-size: 11px; font-variant-numeric: tabular-nums; }
  .app .col-cards { display: grid; gap: 8px; align-content: start; min-height: 60px; }

  .app .card { position: relative; transition: scale .35s cubic-bezier(.34,1.56,.64,1), rotate .35s cubic-bezier(.34,1.56,.64,1), box-shadow .3s, background .3s; padding: 11px 11px 10px; border-radius: 11px; background: #17171d; box-shadow: inset 0 0 0 1px rgba(255,255,255,.065), 0 2px 6px rgba(0,0,0,.35); }
  .app .card.lifted { z-index: 20; scale: 1.035; rotate: 1.6deg; background: #1e1e27; box-shadow: inset 0 0 0 1px rgba(84,214,183,.6), 0 26px 50px -10px rgba(0,0,0,.85), 0 0 40px rgba(15,159,142,.35); }
  .app .card.done .ttl { color: #a3a2b3; }
  .app .tag { display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px 2px 6px; border-radius: 99px; font-size: 10.5px; font-weight: 500; color: var(--c); background: color-mix(in srgb, var(--c) 13%, transparent); }
  .app .tag i { width: 5px; height: 5px; border-radius: 9px; background: var(--c); }
  .app .card .ttl { margin: 8px 0 10px; font-size: 12.5px; font-weight: 550; letter-spacing: -0.012em; line-height: 1.32; }
  .app .card footer { display: flex; align-items: center; gap: 8px; }
  .app .key { font-family: var(--font-mono); font-size: 10.5px; color: var(--color-fg-3); }
  .app .prio { display: flex; align-items: flex-end; gap: 2px; height: 11px; margin-left: 2px; }
  .app .prio i { width: 3px; border-radius: 2px; background: #2a2a33; } .app .prio i:nth-child(1) { height: 4px; } .app .prio i:nth-child(2) { height: 7px; } .app .prio i:nth-child(3) { height: 11px; }
  .app .prio[data-p='1'] i:nth-child(-n+1), .app .prio[data-p='2'] i:nth-child(-n+2), .app .prio[data-p='3'] i { background: #fbbf24; }
  .app .prio[data-p='3'] i { background: #f87171; }
  .app .av { margin-left: auto; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 99px; font-size: 8.5px; font-weight: 700; color: #fff; box-shadow: 0 0 0 2px #17171d; }

  .app .cursor { position: absolute; left: 0; top: 0; z-index: 40; pointer-events: none; opacity: 0; will-change: transform; filter: drop-shadow(0 6px 10px rgba(0,0,0,.5)); }
  .app .cursor span { position: absolute; left: 14px; top: 16px; padding: 2px 8px; border-radius: 99px 99px 99px 3px; background: var(--cc); color: #fff; font-size: 10.5px; font-weight: 600; white-space: nowrap; }

  .app .drop-ring { position: absolute; z-index: 30; width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 99px; border: 2px solid #34d399; pointer-events: none; animation: pulse-ring 0.9s ease-out forwards; }

  @media (max-width: 899px) {
    .app { --w: 760px; }
    .app .side { display: none; }
  }
</style>


