---
import Layout from '../layouts/Layout.astro';
import InnerHero from '../components/InnerHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { pricing } from '../i18n/pages';
import { ui } from '../i18n/ui';
import { url, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = pricing[lang];
const t = ui[lang].common;
const crumbs = [{ name: t.breadcrumbHome, href: url('home', lang) }, { name: c.eyebrow, href: url('pricing', lang) }];
const ld = [];
---
<Layout title={c.metaTitle} description={c.metaDesc} lang={lang} routeKey="pricing" breadcrumbs={crumbs} jsonLd={ld}>
  <InnerHero eyebrow={c.eyebrow} title={c.h1} lead={c.lead} />

  <section class="section !pt-4">
    <div class="wrap">
      <div class="grid gap-5 lg:grid-cols-[1.15fr_1fr]">
        <article class="plan plan-main spot" data-reveal>
          <span class="plan-badge">{c.free.period}</span>
          <h2>{c.free.name}</h2>
          <p class="plan-price">{c.free.price}</p>
          <p class="plan-desc">{c.free.desc}</p>
          <a href={url('contact', lang)} data-magnetic class="btn btn-primary btn-lg mt-8 w-full">{c.free.cta} <Icon name="arrow-right" class="arrow" /></a>
          <ul class="plan-list">
            {c.free.items.map((i) => <li><Icon name="check" size={16} stroke={2.5} />{i}</li>)}
          </ul>
        </article>
        <article class="plan spot" data-reveal>
          <span class="plan-badge plan-badge-dim">{c.teams.price}</span>
          <h2>{c.teams.name}</h2>
          <p class="plan-desc mt-4">{c.teams.desc}</p>
          <a href={url('contact', lang)} data-magnetic class="btn btn-ghost btn-lg mt-8 w-full">{c.teams.cta}</a>
          <ul class="plan-list">
            {c.teams.items.map((i) => <li><Icon name="check" size={16} stroke={2.5} />{i}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <Faq title={c.faqTitle} items={c.faq} />
  <CtaBand title={ui[lang].nav.cta} primary={t.createAccount} lang={lang} />
</Layout>
<style is:global>
  .plan { padding: clamp(1.8rem, 3vw, 2.6rem); background: var(--color-card); box-shadow: inset 0 0 0 1px var(--color-line-strong); }
  .plan-main { background: linear-gradient(145deg,#e5f1e9,#fff 78%); box-shadow: inset 0 0 0 1px rgba(22,115,95,.28), 0 30px 70px -55px rgba(13,65,52,.35); }
  .plan h2 { margin-top: 1.2rem; font-size: 1.4rem; font-weight: 600; letter-spacing: -.03em; }
  .plan-badge { display: inline-block; padding: 4px 12px; border-radius: 99px; font-size: .75rem; font-weight: 600; color: #fff; background: rgba(15,159,142,.5); }
  .plan-badge-dim { background: var(--color-surface); color: var(--color-fg-2); }
  .plan-price { margin-top: .6rem; font-size: clamp(3rem, 6vw, 4.6rem); font-weight: 600; letter-spacing: -.05em; line-height: 1; }
  .plan-desc { margin-top: .9rem; color: var(--color-fg-2); line-height: 1.6; max-width: 34ch; }
  .plan-list { list-style: none; margin: 2rem 0 0; padding: 2rem 0 0; border-top: 1px solid var(--color-line); display: grid; gap: .85rem; }
  .plan-list li { display: flex; align-items: center; gap: .75rem; font-size: .95rem; color: var(--color-fg); }
  .plan-list svg { flex: none; color: var(--color-ok); }
</style>

