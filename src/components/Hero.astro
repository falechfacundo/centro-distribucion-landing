---
import HeroBoard from './HeroBoard.astro';
import Icon from './Icon.astro';
import { home } from '../i18n/home';
import { url, type Lang } from '../i18n/routes';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const c = home[lang].hero;
---
<section id="top" class="hero relative overflow-hidden pb-20 pt-32 sm:pt-36 lg:pb-24 lg:pt-40">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute right-[-14%] top-[-18%] h-[70vmin] w-[70vmin] rounded-full bg-emerald-700/[.08] blur-[120px]"></div>
    <div class="absolute left-[-15%] top-[42%] h-[34vmin] w-[34vmin] rounded-full bg-amber-500/[.07] blur-[110px]"></div>
  </div>
  <div class="wrap-wide relative">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,.82fr)_minmax(0,1.18fr)] lg:gap-7">
      <div class="hero-copy max-w-[38rem]">
        <p class="eyebrow mb-7" data-hero-in>{c.badge}</p>
        <h1 class="hero-title h-display" aria-label={c.aria}>
          <span class="split-line" aria-hidden="true"><span>{c.l1}</span></span>
          <span class="split-line" aria-hidden="true"><span>{c.l2}</span></span>
          <span class="split-line" aria-hidden="true"><span class="grad-accent">{c.l3}</span></span>
        </h1>
        <p data-hero-in class="lead mt-7 max-w-[36rem]">{c.lead}</p>
        <div data-hero-in class="mt-9 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <a href={url('contact', lang)} data-magnetic class="btn btn-primary btn-lg">{c.cta1} <Icon name="arrow-right" class="arrow" /></a>
          <a href="#producto" data-magnetic class="btn btn-ghost btn-lg">{c.cta2}</a>
        </div>
        <p data-hero-in class="mt-5 max-w-[34rem] text-sm text-fg-3">{c.note}</p>
      </div>
      <div data-hero-in class="hero-demo min-w-0 lg:ml-[-2rem]">
        <HeroBoard lang={lang} />
      </div>
    </div>
  </div>
</section>
<style is:global>
  .hero-title { font-size: clamp(2.8rem, 6vw, 5.4rem); }
  .hero-demo { position: relative; }
  .hero-demo::before { content: ''; position: absolute; inset: 12% 4% 5% 16%; border-radius: 32px; background: rgba(22,115,95,.08); filter: blur(34px); pointer-events: none; }
  @media (max-width: 1023px) { .hero-copy { margin-inline: auto; text-align: center; } .hero-copy .eyebrow { justify-content: center; } .hero-copy .lead { margin-inline: auto; } .hero-copy > div { justify-content: center; } .hero-copy > p:last-child { margin-inline: auto; } .hero-demo { margin-inline: auto; width: 100%; max-width: 760px; } }
</style>
