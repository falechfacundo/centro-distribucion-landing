{
  "name": "flowboard-landing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-icons.mjs && astro dev",
    "build": "node scripts/sync-icons.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "icons": "node scripts/sync-icons.mjs",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:ui": "playwright test --ui",
    "test:mobile": "playwright test --grep-invert @visual --project=iphone-se --project=iphone-14 --project=pixel-7",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-static": "^1.48.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.4.2"
}
