---
import Icon from './Icon.astro';
import { home } from '../i18n/home';
import type { Lang } from '../i18n/routes';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const c = home[lang].bento;
const cards = [c.ai, c.okr, c.git, c.time, c.pf];
const icons = ['folder', 'layers', 'git-branch', 'check-check', 'home'];
---
<section id="funciones" class="section">
  <div class="wrap">
    <header class="cap-head">
      <p class="eyebrow mb-5" data-reveal>{c.eyebrow}</p>
      <h2 class="h-section" data-reveal>{c.h2}</h2>
      <p class="lead mt-5" data-reveal>{c.lead}</p>
    </header>
    <div class="cap-grid">
      {cards.map((item, index) => <article class="cap-card" data-reveal>
        <div class="cap-meta"><span class="cap-icon"><Icon name={icons[index]} size={18} /></span><span>{item.tag}</span><small>0{index + 1}</small></div>
        <h3>{item.h}</h3><p>{item.p}</p>
      </article>)}
    </div>
  </div>
</section>
<style>
  .cap-head { max-width:54rem; margin-bottom:3.2rem; }
  .cap-head .lead { max-width:39rem; }
  .cap-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); border-top:1px solid var(--color-line-strong); border-left:1px solid var(--color-line-strong); }
  .cap-card { grid-column:span 2; min-height:225px; padding:clamp(1.25rem,3vw,2rem); border-right:1px solid var(--color-line-strong); border-bottom:1px solid var(--color-line-strong); background:transparent; transition:background .25s; }
  .cap-card:hover { background:var(--color-card); }
  .cap-card:nth-child(4) { grid-column:2 / span 2; }
  .cap-meta { display:flex; align-items:center; gap:.65rem; color:var(--color-accent-2); font: .68rem var(--font-mono); letter-spacing:.08em; text-transform:uppercase; }
  .cap-meta small { margin-left:auto; color:var(--color-fg-3); font:inherit; }
  .cap-icon { display:grid; place-items:center; width:34px; height:34px; border:1px solid var(--color-line-strong); color:var(--color-accent-2); }
  .cap-card h3 { margin:1.6rem 0 .55rem; color:var(--color-fg); font-size:1.2rem; line-height:1.25; letter-spacing:-.025em; }
  .cap-card p { max-width:34rem; margin:0; color:var(--color-fg-2); font-size:.9rem; line-height:1.65; }
  @media(max-width:760px) { .cap-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }.cap-card,.cap-card:nth-child(4) { grid-column:span 1; }.cap-card:last-child { grid-column:1 / -1; } }
  @media(max-width:480px) { .cap-grid { display:block; }.cap-card { min-height:0; border-left:0; border-right:0; }.cap-card h3 { margin-top:1rem; } }
</style>
