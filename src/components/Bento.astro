---
import Icon from './Icon.astro';
import { home } from '../i18n/home';
import type { Lang } from '../i18n/routes';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const c = home[lang].bento;
const tickets = c.ai.tickets;
const krs = c.okr.krs;
const projects = c.pf.items;
---
<section id="funciones" class="section">
  <div class="wrap">
    <div class="mx-auto max-w-[760px] text-center">
      <p class="eyebrow mb-6" data-reveal>{c.eyebrow}</p>
      <h2 class="h-section grad-text" data-reveal>{c.h2}</h2>
      <p class="lead mx-auto mt-6 max-w-[34rem]" data-reveal>{c.lead}</p>
    </div>

    <div class="bento mt-16 grid gap-4 md:mt-20 md:grid-cols-6" data-bento-grid>
      <!-- IA -->
      <article class="bcard spot md:col-span-3" data-bento data-reveal>
        <div class="bhead"><span class="bic"><Icon name="sparkles" size={18} /></span><span class="btag">{c.ai.tag}</span></div>
        <h3>{c.ai.h}</h3>
        <p>{c.ai.p}</p>
        <div class="bvis ai">
          <div class="ai-prompt"><Icon name="sparkles" size={14} class="text-accent-2" /><span class="typing" style={`--n:${c.ai.prompt.length}`}>{c.ai.prompt}</span><i class="caret"></i></div>
          <ul class="ai-list">
            {tickets.map(([t, c, title], i) => (
              <li style={`--i:${i}`}>
                <span class="mtag" style={`--c:${c}`}><i></i>{t}</span>
                <span>{title}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>

      <!-- OKR -->
      <article class="bcard spot md:col-span-3" data-bento data-reveal>
        <div class="bhead"><span class="bic"><Icon name="target" size={18} /></span><span class="btag">{c.okr.tag}</span></div>
        <h3>{c.okr.h}</h3>
        <p>{c.okr.p}</p>
        <div class="bvis okr">
          <div class="okr-ring">
            <svg viewBox="0 0 120 120">
              <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,.07)" stroke-width="9" />
              <circle class="okr-ring-fg" cx="60" cy="60" r="50" fill="none" stroke="url(#rg)" stroke-width="9" stroke-linecap="round" pathLength="100" transform="rotate(-90 60 60)" style="--v:70" />
              <defs><linearGradient id="rg" x1="0" x2="1"><stop offset="0" stop-color="#c4baff" /><stop offset="1" stop-color="#6e5cf5" /></linearGradient></defs>
            </svg>
            <div><b data-count-to="70">0</b><small>%</small></div>
          </div>
          <ul class="krs">
            {krs.map(([t, v, c], i) => (
              <li>
                <div><span>{t}</span><b>{v}%</b></div>
                <div class="kbar"><i style={`--v:${v}%;--c:${c};--i:${i}`}></i></div>
              </li>
            ))}
          </ul>
        </div>
      </article>

      <!-- Git -->
      <article class="bcard spot md:col-span-2" data-bento data-reveal>
        <div class="bhead"><span class="bic"><Icon name="git-branch" size={18} /></span><span class="btag">{c.git.tag}</span></div>
        <h3>{c.git.h}</h3>
        <p>{c.git.p}</p>
        <div class="bvis git">
          <div class="commit">
            <Icon name="git-commit-horizontal" size={16} class="text-fg-3" />
            <code>{c.git.commit} <em>#a8f3k2x</em></code>
          </div>
          <svg class="gline" viewBox="0 0 20 40" preserveAspectRatio="none"><path d="M10 0 V40" stroke="url(#gg)" stroke-width="1.5" stroke-dasharray="3 4" /><defs><linearGradient id="gg" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#6e5cf5" stop-opacity="0" /><stop offset="1" stop-color="#9b8bff" /></linearGradient></defs></svg>
          <div class="linked"><span class="mtag" style="--c:#34d399"><i></i>Frontend</span><span>{c.git.task}</span><Icon name="check-check" size={15} class="ml-auto text-ok" /></div>
        </div>
      </article>

      <!-- Time -->
      <article class="bcard spot md:col-span-2" data-bento data-reveal>
        <div class="bhead"><span class="bic"><Icon name="timer" size={18} /></span><span class="btag">{c.time.tag}</span></div>
        <h3>{c.time.h}</h3>
        <p>{c.time.p}</p>
        <div class="bvis time">
          <div class="clock"><span class="live"></span><b data-timer="8077">02:14:37</b></div>
          <div class="wk">
            {[38, 64, 52, 86, 70, 24, 12].map((h, i) => (
              <div><i style={`--h:${h}%;--i:${i}`}></i><span>{c.time.days[i]}</span></div>
            ))}
          </div>
        </div>
      </article>

      <!-- Portfolios -->
      <article class="bcard spot md:col-span-2" data-bento data-reveal>
        <div class="bhead"><span class="bic"><Icon name="briefcase" size={18} /></span><span class="btag">{c.pf.tag}</span></div>
        <h3>{c.pf.h}</h3>
        <p>{c.pf.p}</p>
        <div class="bvis pf">
          {projects.map(([t, v, c], i) => (
            <div class="pf-row" style={`--i:${i}`}>
              <span class="pf-dot" style={`background:${c}`}></span><span>{t}</span><b>{v}%</b>
              <div class="kbar"><i style={`--v:${v}%;--c:${c};--i:${i}`}></i></div>
            </div>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>

<style is:global>
  .bcard { display: flex; flex-direction: column; padding: clamp(1.4rem, 2.4vw, 2rem); border-radius: 26px; background: linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.015)); box-shadow: inset 0 0 0 1px var(--color-line), inset 0 1px 0 rgba(255,255,255,.06); min-height: 22rem; }
  .bhead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.4rem; }
  .bic { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; color: var(--color-accent-3); background: rgba(110,92,245,.14); box-shadow: inset 0 0 0 1px rgba(110,92,245,.3); }
  .btag { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-fg-3); }
  .bcard h3 { font-size: clamp(1.2rem, 1.7vw, 1.5rem); font-weight: 600; letter-spacing: -.03em; line-height: 1.2; text-wrap: balance; max-width: 22ch; }
  .bcard > p { margin-top: .6rem; color: var(--color-fg-2); font-size: .95rem; line-height: 1.55; max-width: 34ch; text-wrap: pretty; }
  .bvis { margin-top: auto; padding-top: 1.6rem; }

  /* IA */
  .ai-prompt { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 12px; background: #0d0d11; box-shadow: inset 0 0 0 1px var(--color-line-strong); font-size: 13px; color: var(--color-fg); }
  .typing { display: inline-block; overflow: hidden; white-space: nowrap; width: 0; vertical-align: bottom; }
  .caret { width: 1.5px; height: 15px; background: var(--color-accent-2); animation: blink 1s steps(2) infinite; margin-left: -6px; }
  .ai-list { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 6px; }
  .ai-list li { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 10px; background: rgba(255,255,255,.03); box-shadow: inset 0 0 0 1px var(--color-line); font-size: 12.5px; opacity: 0; transform: translateY(8px); }
  .ai-list li:nth-child(n+2) { margin-left: 14px; }
  .bcard.in .typing { animation: type 1.6s .3s steps(var(--n)) forwards; }
  .bcard.in .ai-list li { animation: pop .6s calc(2.1s + var(--i) * .28s) var(--ease-soft) forwards; }
  @keyframes type { to { width: calc(var(--n) * 1ch * .93); } }
  @keyframes pop { to { opacity: 1; transform: none; } }

  /* OKR */
  .okr { display: flex; align-items: center; gap: 22px; }
  .okr-ring { position: relative; width: 118px; height: 118px; flex: none; }
  .okr-ring svg { width: 100%; height: 100%; }
  .okr-ring-fg { stroke-dasharray: 100; stroke-dashoffset: 100; filter: drop-shadow(0 0 8px rgba(110,92,245,.7)); }
  .bcard.in .okr-ring-fg { animation: ring 1.8s .2s var(--ease-soft) forwards; }
  @keyframes ring { to { stroke-dashoffset: calc(100 - var(--v)); } }
  .okr-ring > div { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; grid-auto-flow: column; align-items: baseline; }
  .okr-ring b { font-size: 28px; font-weight: 600; letter-spacing: -.04em; font-variant-numeric: tabular-nums; } .okr-ring small { font-size: 13px; color: var(--color-fg-3); }
  .krs { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; flex: 1; min-width: 0; }
  .krs li > div:first-child { display: flex; justify-content: space-between; gap: 10px; font-size: 12.5px; color: var(--color-fg-2); margin-bottom: 7px; } .krs b { color: var(--color-fg); font-weight: 600; font-variant-numeric: tabular-nums; }
  .kbar { height: 5px; border-radius: 9px; background: rgba(255,255,255,.07); overflow: hidden; }
  .kbar i { display: block; height: 100%; width: 0; border-radius: 9px; background: var(--c); box-shadow: 0 0 10px var(--c); }
  .bcard.in .kbar i { animation: grow 1.4s calc(.3s + var(--i) * .15s) var(--ease-soft) forwards; }
  @keyframes grow { to { width: var(--v); } }

  /* Git */
  .commit, .linked { display: flex; align-items: center; gap: 10px; padding: 11px 13px; border-radius: 11px; font-size: 12.5px; background: #0d0d11; box-shadow: inset 0 0 0 1px var(--color-line-strong); }
  .commit code { font-family: var(--font-mono); font-size: 12px; color: var(--color-fg-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .commit em { font-style: normal; color: var(--color-accent-2); background: rgba(110,92,245,.15); padding: 1px 5px; border-radius: 5px; }
  .linked { background: rgba(52,211,153,.05); box-shadow: inset 0 0 0 1px rgba(52,211,153,.25); }
  .linked > span:nth-child(2) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gline { display: block; width: 20px; height: 34px; margin: 0 0 0 22px; }
  .bcard .gline path { stroke-dashoffset: 40; }
  .bcard.in .gline path { animation: dash 1.2s .5s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: 0; } }

  /* Time */
  .clock { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 14px; background: #0d0d11; box-shadow: inset 0 0 0 1px var(--color-line-strong); }
  .clock b { font-family: var(--font-mono); font-size: 1.7rem; font-weight: 500; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .live { position: relative; width: 9px; height: 9px; border-radius: 9px; background: #f87171; box-shadow: 0 0 12px #f87171; } .live::after { content: ''; position: absolute; inset: 0; border-radius: 9px; background: #f87171; animation: pulse-ring 1.6s ease-out infinite; }
  .wk { display: grid; grid-template-columns: repeat(7, 1fr); gap: 7px; height: 76px; margin-top: 14px; align-items: end; }
  .wk div { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 6px; height: 100%; }
  .wk i { display: block; width: 100%; height: 0; border-radius: 6px 6px 3px 3px; background: linear-gradient(180deg, #9b8bff, #6e5cf5); opacity: .95; }
  .bcard.in .wk i { animation: hgrow .9s calc(.2s + var(--i) * .07s) var(--ease-soft) forwards; }
  @keyframes hgrow { to { height: calc(var(--h) * .62); } }
  .wk span { font-size: 10px; color: var(--color-fg-3); font-family: var(--font-mono); }

  /* Portfolios */
  .pf { display: grid; gap: 12px; }
  .pf-row { display: grid; grid-template-columns: 8px 1fr auto; align-items: center; column-gap: 10px; row-gap: 8px; padding: 12px 14px; border-radius: 12px; background: rgba(255,255,255,.03); box-shadow: inset 0 0 0 1px var(--color-line); font-size: 12.5px; }
  .pf-row .kbar { grid-column: 1 / -1; } .pf-dot { width: 8px; height: 8px; border-radius: 9px; } .pf-row b { font-variant-numeric: tabular-nums; color: var(--color-fg-2); font-weight: 500; }
</style>
