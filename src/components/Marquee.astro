---
import Icon from './Icon.astro';
import { home } from '../i18n/home';
import type { Lang } from '../i18n/routes';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const items = home[lang].marquee;
---
<section class="relative border-y border-line bg-surface/40 py-7" aria-label="FlowBoard">
  <div class="overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]">
    <div class="flex w-max gap-3" style="animation:marquee 46s linear infinite">
      {[0, 1].map(() => (
        <ul class="flex shrink-0 gap-3" aria-hidden={false}>
          {items.map(([ic, label]) => (
            <li class="flex items-center gap-2.5 rounded-full border border-line bg-white/[0.02] px-5 py-2.5 text-[0.9rem] text-fg-2">
              <Icon name={ic} size={16} class="text-accent-2" /> {label}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
