---
import Layout from '../layouts/Layout.astro';
import InnerHero from '../components/InnerHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { compare } from '../i18n/pages';
import { ui } from '../i18n/ui';
import { url, compareKeys, type CompareKey, type Lang } from '../i18n/routes';

interface Props { lang: Lang; ckey: CompareKey }
const { lang, ckey } = Astro.props;
const C = compare[lang];
const c = C.data[ckey];
const name = C.names[ckey];
const t = ui[lang].common;
const crumbs = [{ name: t.breadcrumbHome, href: url('home', lang) }, { name: ui[lang].nav.compare, href: url(ckey, lang) }, { name, href: url(ckey, lang) }];
const others = compareKeys.filter((k) => k !== ckey);
---
<Layout title={c.metaTitle} description={c.metaDesc} lang={lang} routeKey={ckey} breadcrumbs={crumbs}>
  <InnerHero eyebrow={ui[lang].nav.compare} title={c.h1} lead={c.lead} crumbs={crumbs}>
    <a href={url('contact', lang)} data-magnetic class="btn btn-primary btn-lg">{t.startFree} <Icon name="arrow-right" class="arrow" /></a>
  </InnerHero>

  <section class="section !pt-4">
    <div class="wrap">
      <h2 class="eyebrow mb-8" data-reveal>{C.h.quick}</h2>
      <div class="grid gap-5 md:grid-cols-2">
        <article class="cmp cmp-fb spot" data-reveal><h3>Centro Distribución</h3><p>{c.quick.fb}</p></article>
        <article class="cmp spot" data-reveal><h3>{name}</h3><p>{c.quick.other}</p></article>
      </div>
    </div>
  </section>

  <section class="section !pt-0">
    <div class="wrap">
      <div class="grid gap-5 md:grid-cols-2">
        <div class="cmp-list" data-reveal>
          <h2>{C.h.fb}</h2>
          <ul>{c.chooseFb.map((i) => <li><Icon name="check" size={16} stroke={2.5} class="text-ok" />{i}</li>)}</ul>
        </div>
        <div class="cmp-list" data-reveal>
          <h2>{C.h.other(name)}</h2>
          <ul>{c.chooseOther.map((i) => <li><Icon name="arrow-right" size={16} class="text-fg-3" />{i}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section !pt-0">
    <div class="wrap">
      <div class="cmp cmp-fb" data-reveal>
        <h2 class="mb-6 text-[1.3rem] font-semibold tracking-tight">{C.h.includes}</h2>
        <ul class="grid gap-3 sm:grid-cols-2">{C.h.includesList.map((i) => <li class="flex items-center gap-3 text-[.95rem]"><Icon name="check" size={16} stroke={2.5} class="text-ok" />{i}</li>)}</ul>
      </div>
      <p class="mx-auto mt-8 max-w-[52rem] text-center text-[.8rem] leading-relaxed text-fg-3">{C.h.disclaimer}</p>
    </div>
  </section>

  <Faq title={t.faq} items={c.faq} />

  <section class="section !pt-0">
    <div class="wrap">
      <h2 class="eyebrow mb-8" data-reveal>{t.related}</h2>
      <ul class="grid gap-4 md:grid-cols-3">
        {others.map((k) => (
          <li data-reveal><a href={url(k, lang)} class="rel spot"><b>{C.names[k]}</b><Icon name="arrow-right" size={18} class="rel-arrow" /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title={C.h.ctaH} text={C.h.ctaP} primary={t.createAccount} lang={lang} />
</Layout>
<style is:global>
  .cmp { padding: 2rem; border-radius: 26px; background: var(--color-card); box-shadow: inset 0 0 0 1px var(--color-line); }
  .cmp-fb { background: linear-gradient(145deg, #e2f1e9, #f8fbf8 80%); box-shadow: inset 0 0 0 1px rgba(22,115,95,.18), 0 28px 55px -40px rgba(13,65,52,.28); }
  .cmp h3 { font-size: 1.4rem; font-weight: 600; letter-spacing: -.03em; } .cmp p { margin-top: .8rem; color: var(--color-fg-2); line-height: 1.7; }
  .cmp-list h2 { font-size: 1.3rem; font-weight: 600; letter-spacing: -.03em; margin-bottom: 1.2rem; }
  .cmp-list ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .cmp-list li { display: flex; gap: .8rem; align-items: flex-start; color: var(--color-fg-2); line-height: 1.55; } .cmp-list li svg { flex: none; margin-top: .25rem; }
</style>

