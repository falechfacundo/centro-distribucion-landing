---
const icons = import.meta.glob('/src/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
interface Props { name: string; class?: string; size?: number; stroke?: number }
const { name, class: cls = '', size = 20, stroke = 1.75 } = Astro.props;
const raw = icons[`/src/icons/${name}.svg`];
if (!raw) throw new Error(`Icon "${name}" not found (run npm run icons)`);
const inner = raw.replace(/<svg[^>]*>/, '').replace('</svg>', '').replace(/<!--[\s\S]*?-->/g, '');
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true" set:html={inner} />
